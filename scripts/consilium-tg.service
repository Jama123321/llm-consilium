[Unit]
Description=Consilium Telegram bot (free-LLM council)
After=network-online.target consilium-proxy.service
Wants=network-online.target consilium-proxy.service

[Service]
Type=simple
WorkingDirectory=/opt/claude-projects/llm-consilium
ExecStart=/opt/claude-projects/llm-consilium/.venv/bin/python -m consilium_tg
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
